{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": null,
  "buildCommand": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/typsnitt/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/signatur/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/agents{/}?",
      "destination": "https://outreach.spekt.se/",
      "permanent": false
    },
    {
      "source": "/outreach",
      "destination": "https://app.spekt.se/",
      "permanent": false
    },
    {
      "source": "/outreach/",
      "destination": "https://app.spekt.se/",
      "permanent": false
    },
    {
      "source": "/outreach/:path*",
      "destination": "https://app.spekt.se/:path*",
      "permanent": false
    }
  ]
}
